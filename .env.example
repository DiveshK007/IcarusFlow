# Environment Configuration for IcarusFlow
# Copy this file to .env and fill in your values

# ===========================================
# LLM Configuration
# ===========================================
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# ===========================================
# WeilChain Configuration
# ===========================================
WEIL_CHAIN_RPC_URL=https://rpc.weilchain.io
WEIL_CHAIN_NETWORK=mainnet
WEIL_PRIVATE_KEY=your_weil_private_key_here
WEIL_CONTRACT_ADDRESS=your_workflow_contract_address

# ===========================================
# Enterprise Connectors
# ===========================================

# Snowflake Configuration
SNOWFLAKE_ACCOUNT=your_account
SNOWFLAKE_USERNAME=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_DATABASE=your_database
SNOWFLAKE_WAREHOUSE=your_warehouse
SNOWFLAKE_SCHEMA=public

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your_bucket_name

# Email/SMTP Configuration
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your_email@company.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@icarusflow.io

# Confluence Configuration
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net
CONFLUENCE_API_TOKEN=your_confluence_token
CONFLUENCE_SPACE_KEY=TEAM

# ===========================================
# Logging & Monitoring
# ===========================================
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_AUDIT_LOG=true

# ===========================================
# Security Settings
# ===========================================
ENABLE_POLICY_ENFORCEMENT=true
MAX_WORKFLOW_STEPS=50
EXECUTION_TIMEOUT_MS=300000

{
  "name": "icarus-flow",
  "version": "1.0.0",
  "description": "Multi-Step Agentic Workflows on Icarus - A deterministic, auditable, policy-aware execution layer for enterprise AI workflows",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "icarus-flow": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "cli": "tsx src/cli.ts",
    "vercel-build": "tsc",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "demo": "tsx src/demo/run-workflow.ts",
    "deploy:contract": "tsx scripts/deploy-contract.ts",
    "frontend": "npx serve frontend -p 3000",
    "server": "tsx src/server.ts",
    "deploy": "./scripts/deploy-vercel.sh",
    "deploy:prod": "npm run build && vercel --prod"
  },
  "keywords": [
    "icarus",
    "weil-sdk",
    "agentic-ai",
    "workflow",
    "blockchain",
    "mcp",
    "enterprise"
  ],
  "author": "IcarusFlow Team",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.964.0",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ethers": "^6.16.0",
    "express": "^5.2.1",
    "nodemailer": "^7.0.12",
    "openai": "^4.20.0",
    "snowflake-sdk": "^2.3.3",
    "uuid": "^9.0.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^7.0.4",
    "@types/snowflake-sdk": "^1.6.24",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vercel/node": "^5.5.16",
    "eslint": "^8.55.0",
    "hardhat": "^3.1.2",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}